# ====================
# LLM 配置
# ====================
LLM_PROVIDER=dashscope          # dashscope | openai | ollama
LLM_MODEL=qwen-turbo

# 通义千问 LLM API（DashScope）
DASHSCOPE_API_KEY=sk-your-key-here

# OpenAI LLM
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama（本地）
# OLLAMA_BASE_URL=http://localhost:11434

# ====================
# Embedding 配置
# ====================
# 三种模式：local | dashscope | openai
#
# 1) local: 本地 HuggingFace 模型（推荐用 modelscope 下载到 /root/.cache/modelscope/...）
#    示例 EMBEDDING_MODEL:
#      /root/.cache/modelscope/hub/models/BAAI/bge-base-zh-v1.5         (推荐, 100M, 速度快, 768维)
#      /root/.cache/modelscope/hub/models/BAAI/bge-large-zh-v1.5        (326M, 效果稍好, 1024维)
#      /root/.cache/modelscope/hub/models/Qwen/Qwen3-Embedding-0___6B   (600M, 效果最好但慢, 1024维)
#
# 2) dashscope: 阿里云 DashScope Embedding API（需要联网, 复用 DASHSCOPE_API_KEY）
#    示例 EMBEDDING_MODEL:
#      text-embedding-v3   (推荐, 1024维)
#      text-embedding-v2   (1536维)
#
# 3) openai: OpenAI Embedding API（复用 OPENAI_API_KEY）
#    示例 EMBEDDING_MODEL:
#      text-embedding-3-small   (1536维)
#      text-embedding-3-large   (3072维)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=/root/.cache/modelscope/hub/models/BAAI/bge-base-zh-v1.5

# ====================
# 数据存储路径
# ====================
UPLOAD_DIR=./uploads
CHROMA_DIR=./.chroma
SQLITE_URL=sqlite+aiosqlite:////app/data/rag.db

# ====================
# 分块配置
# ====================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# ====================
# 关闭 ChromaDB 烦人的 telemetry 日志
# ====================
ANONYMIZED_TELEMETRY=False